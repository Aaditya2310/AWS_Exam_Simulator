# Copy this file to .env and fill in real values. Never commit .env.

PORT=4000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-value

# Where the SQLite file lives. On Railway, mount a persistent volume
# (e.g. at /data) and set this to /data/app.db — otherwise every
# redeploy wipes all accounts and history.
DB_PATH=./data/app.db

# Comma-separated list of frontend origins allowed to call this API.
# Example: https://your-app.vercel.app,http://localhost:5173
CORS_ORIGIN=http://localhost:5173
